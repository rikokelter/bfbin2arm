@article{Meng1994,
  title = {Posterior {{Predictive}} P-{{Values}}},
  author = {Meng, Xiao-Li},
  year = 1994,
  journal = {Ann. Stat.},
  volume = {22},
  number = {3},
  pages = {1142--1160},
  publisher = {Institute of Mathematical Statistics},
  issn = {0090-5364},
  doi = {10.1214/aos/1176325622},
  abstract = {Extending work of Rubin, this paper explores a Bayesian counterpart\textbackslash nof the classical p-value, namely, a tail-area probability of a "test\textbackslash nstatistic" under a null hypothesis. The Bayesian formulation, using\textbackslash nposterior predictive\textbackslash n\textbackslash nreplications of the data, allows a "test statistic" to depend on both\textbackslash ndata and unknown (nuisance) parameters and thus permits a direct\textbackslash nmeasure of the discrepancy between sample and population quantities.\textbackslash nThe tail-area probability for a "test statistic" is then found under\textbackslash nthe joint posterior distribution of replicate data and the (nuisance)\textbackslash nparameters, both conditional on the null hypothesis. This posterior\textbackslash npredictive p-value can also be viewed as the posterior mean of a\textbackslash nclassical p-value, averaging over the posterior distribution of (nuisance)\textbackslash nparameters under the null hypothesis, and thus it provides one general\textbackslash nmethod for dealing with nuisance parameters. Two classical examples,\textbackslash nincluding the Behrens-Fisher problem, are used to illustrate the\textbackslash n\textbackslash nposterior predictive p-value and some of its interesting properties,\textbackslash nwhich also reveal a new (Bayesian) interpretation for some classical\textbackslash np-values. An application to multiple-imputation inference is also\textbackslash npresented. A frequency evaluation shows that, in general, if the\textbackslash nreplication is defined by new (nuisance) parameters and new data,\textbackslash nthen the Type I frequentist error of an a-level posterior predictive\textbackslash ntest is often close to but less than a and will never exceed 2a.},
  keywords = {$p$-value,62A99,62F03,Bayesian $p$-value,Behrens-Fisher problem,Discrepancy,multiple imputation,nuisance parameter,pivot,significance level,tail-area probability,test variable,Type I error}
}

