@article{Ranalli2019,
  title = {A Statistical Framework for Measuring Reproducibility and Replicability of High-Throughput Experiments from Multiple Sources},
  author = {Ranalli, Monia and Lyu, Yafei and Koch, Hillary and Li, Qunhua},
  year = 2019,
  journal = {bioRxiv},
  pages = {827527},
  publisher = {Cold Spring Harbor Laboratory},
  doi = {10.1101/827527},
  urldate = {2022-03-14},
  abstract = {Replication is essential to reliable and consistent scientific discovery in high-throughput experiments. Quantifying the replicability of scientific discoveries and identifying sources of irreproducibility have become important tasks for quality control and data integration. In this work we introduce a novel statistical model to measure the reproducibility and replicability of findings from replicate experiments in multi-source studies. Using a nested copula mixture model that characterizes the interdependence between replication experiments both across and within sources, our method quantifies reproducibility and replicability of each candidate simultaneously in a coherent framework. Through simulation studies, an ENCODE ChIP-seq dataset and a SEQC RNA-seq dataset, we demonstrate the effectiveness of our method in diagnosing the source of discordance and improving the reliability of scientific discoveries.},
  keywords = {Copula,High-throughput experiment,Irreproducible discovery rate,Mixture models,Replicability,Reproducibility}
}

@article{Rao1992,
  title = {R . {{A}} . {{Fisher}} : {{The Founder}} of {{Modern Statistics}}},
  author = {Rao, C. Radhakrishna},
  year = 1992,
  journal = {Stat. Sci.},
  volume = {7},
  number = {1},
  eprint = {1807.00179v1},
  pages = {34--48},
  publisher = {Institute of Mathematical Statistics},
  issn = {08834237},
  doi = {10.1287/isre.l080.0215},
  urldate = {2018-10-23},
  abstract = {Before the beginning of this century, statistics meant observed data\textbackslash nand descriptive summary figures, such as means, variances, indices,\textbackslash netc., computed from data. With the introduction of the {$\chi$}\textasciicircum 2 test\textbackslash nfor goodness of fit (specification) by Karl Pearson (1900) and the\textbackslash nt test by Gosset (Student, 1908) for drawing inference on the mean\textbackslash nof a normal population, statistics started acquiring new meaning\textbackslash nas a method of processing data to determine the amount of uncertainty\textbackslash nin various generalizations we may make from observed data (sample)\textbackslash nto the source of the data (population). The major steps that led\textbackslash nto the establishment and recognition of statistics as a separate\textbackslash nscientific discipline and an inevitable tool in improving natural\textbackslash nknowledge were made by R. A. Fisher during the decade 1915-1925.\textbackslash nMost of the concepts and methods introduced by Fisher are fundamental\textbackslash nand continue to provide the framework for the discussion of statistical\textbackslash ntheory. Fisher's work is monumental, both in richness and variety\textbackslash nof ideas, and provided the inspiration for phenomenal developments\textbackslash nin statistical methodology for applications in all areas of human\textbackslash nendeavor during the last 75 years. Some of Fisher's pioneering works\textbackslash nhave raised bitter controversies that still continue. These controversies\textbackslash nhave indeed helped in highlighting the intrinsic difficulties in\textbackslash ninductive reasoning and seeking refinements in statistical methodology.},
  archiveprefix = {arXiv},
  isbn = {08834237},
  keywords = {Ancillary statistics,Bayes theorem,confound- ing,confounding,consistency,efficiency,F-test,factorial experiments,fiducial proba- bility,Fisher information,Fisher optimal scores,likelihood,local control,maximum likelihood,nonparametric tests,randomization,regression,replication,roots of determinantal equation,sufficiency}
}

@article{Rao2016,
  title = {Testing Point Null Hypothesis of a Normal Mean and the Truth: 21st {{Century}} Perspective},
  author = {Rao, Calyampudi Radhakrishna and Lovric, Miodrag M.},
  year = 2016,
  journal = {J. Mod. Appl. Stat. Methods},
  volume = {15},
  number = {2},
  pages = {2--21},
  publisher = {Wayne State University},
  issn = {15389472},
  doi = {10.22237/jmasm/1478001660},
  abstract = {Testing a point (sharp) null hypothesis is arguably the most widely used statistical inferential procedure in many fields of scientific research, nevertheless, the most controversial, and misapprehended. Since 1935 when Buchanan-Wollaston raised the first criticism against hypothesis testing, this foundational field of statistics has drawn increasingly active and stronger opposition, including draconian suggestions that statistical significance testing should be abandoned or even banned. Statisticians should stop ignoring these accumulated and significant anomalies within the current point-null hypotheses paradigm and rebuild healthy foundations of statistical science. The foundation for a paradigm shift in testing statistical hypotheses is suggested, which is testing interval null hypotheses based on implications of the Zero probability paradox. It states that in a real-world research point-null hypothesis of a normal mean has zero probability. This implies that formulated point-null hypothesis of a mean in the context of the simple normal model is almost surely false. Thus, Zero probability paradox points to the root cause of so-called large n problem in significance testing. It discloses that there is no point in searching for a cure under the current point-null paradigm.},
  keywords = {Algebraic numbers,Almost sure false null hypothesis,Inexactification,Lebesgue measure,Paradigm shift in testing statistical hypotheses,Point null hypothesis,Rational numbers,Zero-probability paradox},
  file = {/Users/riko/Zotero/storage/YAGPYYTX/full-text.pdf}
}

@article{Rasch2011,
  title = {The Two-Sample t Test: {{Pre-testing}} Its Assumptions Does Not Pay Off},
  author = {Rasch, Dieter and Kubinger, Klaus D. and Moder, Karl},
  year = 2011,
  journal = {Stat. Pap.},
  volume = {52},
  number = {1},
  pages = {219--231},
  publisher = {Springer-Verlag},
  issn = {09325026},
  doi = {10.1007/s00362-009-0224-x},
  urldate = {2019-09-24},
  abstract = {Traditionally, when applying the two-sample t test, some pre-testing occurs. That is, the theory-based assumptions of normal distributions as well as of homogeneity of the variances are often tested in applied sciences in advance of the tried-for t test. But this paper shows that such pre-testing leads to unknown final type-I- and type-II-risks if the respective statistical tests are performed using the same set of observations. In order to get an impression of the extension of the resulting misinterpreted risks, some theoretical deductions are given and, in particular, a systematic simulation study is done. As a result, we propose that it is preferable to apply no pre-tests for the t test and no t test at all, but instead to use the Welch-test as a standard test: its power comes close to that of the t test when the variances are homogeneous, and for unequal variances and skewness values \textbraceleft pipe\textbraceright{$\gamma$}1\textbraceleft pipe\textbraceright{$<$} 3, it keeps the so called 20\% robustness whereas the t test as well as Wilcoxon's U test cannot be recommended for most cases. \copyright{} 2009 Springer-Verlag.},
  keywords = {Pre-tests,Two-sample t test,Welch-test,Wilcoxon-U test},
  file = {/Users/riko/Zotero/storage/L823DRR7/full-text.pdf}
}

