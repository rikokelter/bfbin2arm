@article{Toumazi2018,
  title = {Dfpk: {{An R-package}} for {{Bayesian}} Dose-Finding Designs Using Pharmacokinetics ({{PK}}) for Phase {{I}} Clinical Trials},
  author = {Toumazi, A. and Comets, E. and Alberti, C. and Friede, T. and Lentz, F. and Stallard, N. and Zohar, S. and Ursino, M.},
  year = 2018,
  journal = {Comput. Methods Programs Biomed.},
  volume = {157},
  pages = {163--177},
  publisher = {Comput Methods Programs Biomed},
  issn = {1872-7565},
  doi = {10.1016/J.CMPB.2018.01.023},
  urldate = {2023-01-25},
  abstract = {Background and objective: Dose-finding, aiming at finding the maximum tolerated dose, and pharmacokinetics studies are the first in human studies in the development process of a new pharmacological treatment. In the literature, to date only few attempts have been made to combine pharmacokinetics and dose-finding and to our knowledge no software implementation is generally available. In previous papers, we proposed several Bayesian adaptive pharmacokinetics-based dose-finding designs in small populations. The objective of this work is to implement these dose-finding methods in an R package, called dfpk. Methods: All methods were developed in a sequential Bayesian setting and Bayesian parameter estimation is carried out using the rstan package. All available pharmacokinetics and toxicity data are used to suggest the dose of the next cohort with a constraint regarding the probability of toxicity. Stopping rules are also considered for each method. The ggplot2 package is used to create summary plots of toxicities or concentration curves. Results: For all implemented methods, dfpk provides a function (nextDose) to estimate the probability of efficacy and to suggest the dose to give to the next cohort, and a function to run trial simulations to design a trial (nsim). The sim.data function generates at each dose the toxicity value related to a pharmacokinetic measure of exposure, the AUC, with an underlying pharmacokinetic one compartmental model with linear absorption. It is included as an example since similar data-frames can be generated directly by the user and passed to nsim. Conclusion: The developed user-friendly R package dfpk, available on the CRAN repository, supports the design of innovative dose-finding studies using PK information.},
  pmid = {29477425},
  keywords = {A Toumazi,Bayes Theorem*,Clinical Trials,Cohort Studies,doi:10.1016/j.cmpb.2018.01.023,Dose-Response Relationship,Drug,E Comets,Humans,M Ursino,Maximum Tolerated Dose*,MEDLINE,National Center for Biotechnology Information,National Institutes of Health,National Library of Medicine,NCBI,NIH,NLM,Pharmacokinetics*,Phase I as Topic*,pmid:29477425,PubMed Abstract,Research Design*,Software*},
