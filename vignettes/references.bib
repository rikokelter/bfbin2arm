@article{Schucany2006,
  title = {Preliminary Goodness-of-Fit Tests for Normality Do Not Validate the One-Sample Student t},
  author = {Schucany, William R. and Tony Ng, H. K.},
  year = 2006,
  journal = {Commun. Stat. - Theory Methods},
  volume = {35},
