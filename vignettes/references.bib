@article{Held2019,
  title = {The Assessment of Intrinsic Credibility and a New Argument for {\emph{p}} \&lt; 0.005},
  author = {Held, Leonhard},
  year = 2019,
  journal = {R. Soc. Open Sci.},
  volume = {6},
