  keywords = {Bayes Theorem*,Clinical Trials,doi:10.1177/1740774509105221,Humans,John D Cook,MEDLINE,Monitoring,National Center for Biotechnology Information,National Institutes of Health,National Library of Medicine,NCBI,NIH,NLM,Phase II as Topic / methods*,Physiologic / methods*,pmid:19528131,PubMed Abstract,Valen E Johnson},
