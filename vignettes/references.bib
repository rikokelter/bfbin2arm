@inproceedings{Bandyopadhyay2015,
  title = {Truths about {{Simpson}}'s {{Paradox}} - {{Saving}} the {{Paradox}} from {{Falsity}}},
  booktitle = {Indian {{Conf}}. {{Log}}. {{Its Appl}}.},
  author = {Bandyopadhyay, Prasanta S and Raghavan, R Venkata and Dcruz, Don Wallace and Brittan, Gordon},
  year = 2015,
  pages = {58--73},
  publisher = {Springer},
  urldate = {2023-07-03},
  abstract = {There are three questions associated with Simpson's paradox (SP): (i) Why is SP paradoxical? (ii) What conditions generate SP? and (iii) How to proceed when confronted with SP? An adequate analysis of the paradox starts by distinguishing these three questions. Then, by developing a formal account of SP, and substantiating it with a counterexample to causal accounts, we argue that there are no causal factors at play in answering questions (i) and (ii). Causality enters only in connection with action.},
