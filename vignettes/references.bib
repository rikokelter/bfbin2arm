@book{Lehmann2011,
  title = {Fisher, {{Neyman}}, and the Creation of Classical Statistics},
  author = {Lehmann, E. L.},
  year = 2011,
  publisher = {Springer},
  address = {New York},
  urldate = {2019-01-23},
  abstract = {Classical statistical theory-hypothesis testing, estimation, and the design of experiments and sample surveys-is mainly the creation of two men: Ronald A. Fisher (1890-1962) and Jerzy Neyman (1894-1981). Their contributions sometimes complemented each other, sometimes occurred in parallel, and, particularly at later stages, often were in strong opposition. The two men would not be pleased to see their names linked in this way, since throughout most of their working lives they detested each other. Nevertheless, they worked on the same problems, and through their combined efforts created a new d. Classical statistical theory\textbraceleft u2014\textbraceright hypothesis testing, estimation, and the design of experiments and sample surveys\textbraceleft u2014\textbraceright is mainly the creation of two men:\dbend{} Ronald A. Fisher (1890-1962) and Jerzy Neyman (1894-1981).\dbend{} Their contributions sometimes complemented each other, sometimes occurred in parallel, and, particularly at later stages, often were in strong opposition.\dbend{} The two men would not be pleased to see their names linked in this way, since throughout most of their working lives they detested each other.\dbend{} Nevertheless, they worked on the same problems, and through their combined efforts created a new discipline. This new book by E.L. Lehmann, himself a student of Neyman\textbraceleft u2019\textbraceright s, explores the relationship between Neyman and Fisher, as well as their interactions with other influential statisticians, and the statistical history they helped create together. Lehmann uses direct correspondence and original papers to recreate an historical account of the creation of the Neyman-Pearson Theory as well as Fisher\textbraceleft u2019\textbraceright s dissent, and other important statistical theories. 1) Introduction -- 2) Fisher's Testing Methodology -- 3) The Neyman-Pearson Theory -- 4) Fisher's Dissent -- 5) The Design of Experiments and Sample Surveys -- 6) Estimation -- 7) Epilog -- Appendix -- References -- Name Index -- Subject Index.},
  isbn = {978-1-4419-9499-8}
}

