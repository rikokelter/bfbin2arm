@article{vonHoff2009,
  title = {Long-Term Outcome and Clinical Prognostic Factors in Children with Medulloblastoma Treated in the Prospective Randomised Multicentre Trial {{HIT}}'91},
  author = {von Hoff, Katja and Hinkes, Bernward and Gerber, Nicolas U. and Deinlein, Frank and Mittler, Uwe and Urban, Christian and Benesch, Martin and {Warmuth-Metz}, Monika and Soerensen, Niels and Zwiener, Isabella and Goette, Heiko and Schlegel, Paul G. and Pietsch, Torsten and Kortmann, Rolf D. and Kuehl, Joachim and Rutkowski, Stefan},
  year = 2009,
  journal = {Eur. J. Cancer},
  volume = {45},
  number = {7},
  pages = {1209--1217},
  publisher = {Eur J Cancer},
  issn = {1879-0852},
  doi = {10.1016/J.EJCA.2009.01.015},
  urldate = {2022-01-07},
  abstract = {Purpose: To analyse long-term outcome and clinical prognostic factors in medulloblastoma. Methods: We analysed 280 patients with medulloblastoma (3-18 years) included from 1991 to 1997 in the randomised multicentre trial HIT'91 comparing pre-('sandwich') and postradiation ('maintenance') chemotherapy (median follow-up of survivors for 10 years). Results: In 187 patients with complete staging, overall survival (OS) was higher after maintenance compared to sandwich treatment for M0 (10-year OS 91\% and 62\%, p = 0.001) and M1 patients (10-year OS 70\% and 34\%, p = 0.020). In M2/3 disease, 10-year OS was 42\% and 45\%. Incomplete staging, metastases, younger age and sandwich chemotherapy were independent adverse risk factors. Twelve percent of all relapses (13 of 107) occurred after more than five years, and 12 patients had secondary neoplasms. Conclusions: After maintenance therapy, long-term survival was excellent in fully assessable patients with localised medulloblastoma, and favourable for M1 patients. Patients should be followed longer for late relapses and secondary tumours. \copyright{} 2009 Elsevier Ltd. All rights reserved.},
  pmid = {19250820},
  keywords = {Adolescent,Antineoplastic Agents / therapeutic use,Bernward Hinkes,Cerebellar Neoplasms / drug therapy,Cerebellar Neoplasms / radiotherapy,Cerebellar Neoplasms / surgery*,Child,Combined Modality Therapy,doi:10.1016/j.ejca.2009.01.015,Drug Administration Schedule,Female,Follow-Up Studies,Humans,Katja von Hoff,Local,Male,MEDLINE,Medulloblastoma / drug therapy,Medulloblastoma / radiotherapy,Medulloblastoma / surgery*,Multicenter Study,National Center for Biotechnology Information,National Institutes of Health,National Library of Medicine,NCBI,Neoplasm,Neoplasm Recurrence,Neoplasm Staging,Neoplasms,NIH,NLM,Non-U.S. Gov't,pmid:19250820,Preschool,Proportional Hazards Models,PubMed Abstract,Randomized Controlled Trial,Research Support,Residual,Second Primary,Stefan Rutkowski,Survival Rate,Treatment Outcome,Vincristine / therapeutic use}
