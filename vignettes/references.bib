@article{Begley2015,
  title = {Reproducibility in Science: {{Improving}} the Standard for Basic and Preclinical Research},
  author = {Begley, C. Glenn and Ioannidis, John P.A.},
  year = 2015,
  journal = {Circ. Res.},
  volume = {116},
