  publisher = {Wiley},
  doi = {10.1111/j.2517-6161.1967.tb00676.x},
  abstract = {An attack on the problem of goodness of fit is made by combining a\textbackslash nBayesian and sampling argument; the Bayesian part is effected by\textbackslash nusing the distribution of a future observation, while the sampling\textbackslash nargument concerns itself with the distribution of a "chi-squared\textbackslash nlike" statistic, which measures discrepancies of observed frequencies\textbackslash nfrom those predicted by the distribution of the future observation.\textbackslash nExamples are given for the case of sampling from the binomial, Poisson\textbackslash nand normal distributions. An interesting application arising from\textbackslash nthe above approach is a procedure for estimating the degree of a\textbackslash npolynomial response function.}
