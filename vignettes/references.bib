@article{Boulesteix2015,
  title = {Publication {{Bias}} in {{Methodological Computational Research}}.},
  author = {Boulesteix, Anne-Laure and Stierle, Veronika and Hapfelmeier, Alexander},
  year = 2015,
  journal = {Cancer Inform.},
  volume = {14},
  number = {Suppl 5},
