@article{Kunz2017,
  title = {Two-Stage Phase {{II}} Oncology Designs Using Short-Term Endpoints for Early Stopping},
  author = {Kunz, Cornelia U. and Wason, James M.S. and Kieser, Meinhard},
  year = 2017,
  journal = {Stat. Methods Med. Res.},
  volume = {26},
  number = {4},
