@article{Cheung2016,
  title = {Analyzing {{Big Data}} in {{Psychology}}: {{A Split}}/{{Analyze}}/{{Meta-Analyze Approach}}},
  author = {Cheung, Mike W.-L. and Jak, Suzanne},
  year = 2016,
  journal = {Front. Psychol.},
