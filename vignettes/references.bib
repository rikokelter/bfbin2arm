  booktitle = {Bayesian {{Statistics}} ({{Vol}}. 8)},
  author = {Rousseau, Judith},
  editor = {Bernado, J.M. and Berger, J.O. and Dawid, A.P. and Smith, A.F.M.},
  year = 2007,
  pages = {417--452},
