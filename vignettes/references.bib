@article{Karlas2021,
  title = {Diagnostic {{Value}} of {{Ultrasound}} in {{Fatty Liver Disease}}},
  author = {Karlas, Thomas and Blank, Valentin and B{\"o}hlig, Albrecht},
  year = 2021,
  journal = {Ultraschall Med.},
