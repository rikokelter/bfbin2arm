@article{Blackwelder1982,
  title = {"{{Proving}} the Null Hypothesis" in Clinical Trials},
  author = {Blackwelder, William C.},
  year = 1982,
  journal = {Control. Clin. Trials},
  volume = {3},
  number = {4},
  pages = {345--353},
  publisher = {Control Clin Trials},
  issn = {01972456},
  doi = {10.1016/0197-2456(82)90024-1},
  urldate = {2021-04-19},
  abstract = {When designing a clinical trial to show whether a new or experimental therapy is as effective as a standard therapy (but not necessarily more effective), the usual null hypothesis of equality is inappropriate and leads to logical difficulties. Since therapies cannot be shown to be literally equivalent, the appropriate null hypothesis is that the standard therapy is more effective than the experimental therapy by at least some specified amount. The problem is presented in terms of a trial in which the outcome of interest is dichotomous; test statistics, confidence intervals, and sample size calculations are discussed. The required sample size may be larger for either null hypothesis formulation than for the other, depending on the specific assumptions made. Reporting results in terms of confidence intervals is especially useful for this type of trial. \copyright{} 1982.},
  pmid = {7160191},
  keywords = {confidence interval,design,null hypothesis,sample size}
}

@article{blantonElementaryGradesStudents2004,
