@article{Kelter2022,
  title = {Power Analysis and Type {{I}} and Type {{II}} Error Rates of {{Bayesian}} Nonparametric Two-Sample Tests for Location-Shifts Based on the {{Bayes}} Factor under {{Cauchy}} Priors},
  author = {Kelter, Riko},
