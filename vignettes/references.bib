@article{Giustina2023,
  title = {Vitamin {{D}} Status and Supplementation before and after {{Bariatric Surgery}}: {{Recommendations}} Based on a Systematic Review and Meta-Analysis},
  author = {Giustina, Andrea and {di Filippo}, Luigi and Facciorusso, Antonio and Adler, Robert A. and Binkley, Neil and Bollerslev, Jens and Bouillon, Roger and Casanueva, Felipe F. and Cavestro, Giulia Martina and Chakhtoura, Marlene and Conte, Caterina and Donini, Lorenzo M. and Ebeling, Peter R. and Fassio, Angelo and Frara, Stefano and Gagnon, Claudia and Latella, Giovanni and Marcocci, Claudio and Mechanick, Jeffrey I. and Minisola, Salvatore and Rizzoli, Ren{\'e} and Santini, Ferruccio and Shaker, Joseph L. and Sempos, Christopher and Ulivieri, Fabio Massimo and Virtanen, Jyrki K. and Napoli, Nicola and Schafer, Anne L. and Bilezikian, John P.},
  year = 2023,
  journal = {Rev. Endocr. Metab. Disord.},
  volume = {24},
  number = {6},
  pages = {1011--1029},
  publisher = {Rev Endocr Metab Disord},
  issn = {1573-2606},
  doi = {10.1007/S11154-023-09831-3},
  urldate = {2024-04-22},
  abstract = {Bariatric surgery is associated with a postoperative reduction of 25(OH) vitamin D levels (25(OH)D) and with skeletal complications. Currently, guidelines for 25(OH)D assessment and vitamin D supplementation in bariatric patients, pre- and post-surgery, are still lacking. The aim of this work is to analyse systematically the published experience on 25(OH)D status and vitamin D supplementation, pre- and post-surgery, and to propose, on this basis, recommendations for management. Preoperatively, 18 studies including 2,869 patients were evaluated. Prevalence of vitamin D insufficiency as defined by 25(OH)D {$<$} 30 ng/mL (75 nmol/L) was 85\%, whereas when defined by 25(OH)D {$<$} 20 ng/mL (50 nmol/L) was 57\%. The median preoperative 25(OH)D level was 19.75 ng/mL. After surgery, 39 studies including 5,296 patients were analysed and among those undergoing either malabsorptive or restrictive procedures, a lower rate of vitamin D insufficiency and higher 25(OH)D levels postoperatively were observed in patients treated with high-dose oral vitamin D supplementation, defined as {$\geq$} 2,000 IU/daily (mostly D3-formulation), compared with low-doses ({$<$} 2,000 IU/daily). Our recommendations based on this systematic review and meta-analysis should help clinical practice in the assessment and management of vitamin D status before and after bariatric surgery. Assessment of vitamin D should be performed pre- and postoperatively in all patients undergoing bariatric surgery. Regardless of the type of procedure, high-dose supplementation is recommended in patients after bariatric surgery.},
  pmid = {37665480},
  keywords = {Andrea Giustina,Bariatric Surgery*,Dietary Supplements,doi:10.1007/s11154-023-09831-3,Humans,John P Bilezikian,Luigi di Filippo,MEDLINE,Meta-Analysis,National Center for Biotechnology Information,National Institutes of Health,National Library of Medicine,NCBI,NIH,NLM,PMC10698146,pmid:37665480,PubMed Abstract,Review,Systematic Review,Vitamin D,Vitamin D Deficiency* / drug therapy,Vitamin D Deficiency* / epidemiology,Vitamin D Deficiency* / etiology,Vitamins / therapeutic use}
}

